-- Q5: Store ranking

SELECT Store_Locations.StoreId, SUM(Store_Sales.Sale_Amount) AS total_revenue
FROM Store_Sales
JOIN Store_Locations
    ON Store_Sales.Store_ID = Store_Locations.StoreId
WHERE Store_Locations.State = 'Texas' 
GROUP BY Store_Locations.StoreId
ORDER BY total_revenue DESC; 

-- Answer: Texas Stores ranked by total revenue, highest to lowest 
-- Store 905 ranks first, with total revenue of $637,818.90 so store 905 ranks first. 
-- Store 907 ranks last with $54,444.05 below the other stores

